# Keep this URL private.
SHOPEE_FEED_URL=https://affiliate.shopee.co.th/api/v1/datafeed/download?id=REPLACE_ME
# Obtain this value from your own Shopee Affiliate account; never copy a docs example.
SHOPEE_AFFILIATE_ID=
SHOPEE_SUB_ID_PREFIX=pickora
PIPELINE_ENV=production

TZ=Asia/Bangkok
WEB_PORT=8080
# Check the Affiliate Feed every 2 hours. Confirm the allowed download rate
# for your Shopee Affiliate account before lowering this value.
SYNC_INTERVAL_HOURS=2
SITE_URL=https://pickora.hotelcarepro.com
# Create a GA4 web data stream and paste its Measurement ID (for example G-ABC123DE45).
GA4_MEASUREMENT_ID=
# HTTPS endpoint that accepts POST JSON: {"email":"...","source":"pickora"}.
EMAIL_SUBSCRIBE_ENDPOINT=
# Content value from the Google Search Console HTML meta verification tag.
GOOGLE_SITE_VERIFICATION=
LINK_CHECK_SAMPLE=20
LINK_CHECK_TIMEOUT=12
# Numeric GA4 property ID, not the G- measurement ID.
GA4_PROPERTY_ID=
SEARCH_CONSOLE_SITE_URL=https://pickora.hotelcarepro.com/
# Base64 of the complete service-account JSON file. Never expose this in frontend code.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
GOOGLE_API_TIMEOUT=30
# Long random value used only by the server-side dashboard login.
ANALYTICS_DASHBOARD_TOKEN=
# HttpOnly dashboard session lifetime. Keep secure cookies enabled in production.
ANALYTICS_SESSION_SECONDS=28800
ANALYTICS_COOKIE_SECURE=true

CHUNK_SIZE=50000
MAX_PRODUCTS=600
TOP_PER_CHUNK=300

MIN_PRICE=50
MAX_PRICE=2500
MIN_RATING=4.5
MIN_SOLD=0

# Optional comma-separated keywords. Leave blank to allow all categories.
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=adult,weapon,alcohol,cigarette,vape

# Ranking weights
WEIGHT_SOLD=0.50
WEIGHT_RATING=1000
WEIGHT_DISCOUNT=20
